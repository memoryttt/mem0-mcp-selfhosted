# mem0-mcp-selfhosted environment variables
# Copy to .env and fill in values. Never commit .env with real secrets.

# --- Main LLM (OpenAI-compatible) ---
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=http://100.105.112.4:8317/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Embedder (OpenAI-compatible endpoint) ---
# EMBEDDING_API_KEY=replace-me
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# MEM0_EMBED_DIMS=1024

# --- Vector Store (Qdrant) ---
# MEM0_QDRANT_URL=http://127.0.0.1:6333
# MEM0_COLLECTION=mem0_mcp_selfhosted
# MEM0_QDRANT_API_KEY=
# MEM0_QDRANT_ON_DISK=false
# MEM0_QDRANT_TIMEOUT=

# --- Explicitly removed in this safe fork ---
# MEM0_ENABLE_GRAPH=false

# --- Server ---
# MEM0_HOST=0.0.0.0
# MEM0_PORT=8081
# MEM0_TRANSPORT=stdio
# MEM0_LOG_LEVEL=INFO

# --- Memory Defaults ---
# MEM0_USER_ID=default
# MEM0_HISTORY_DB_PATH=
